rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- COLECCIONES PRINCIPALES ----------
    match /propiedades/{id} {
      allow read, write: if request.auth != null;
    }

    match /inquilinos/{id} {
      allow read, write: if request.auth != null;
    }

    match /reclamos/{id} {
      allow read, write: if request.auth != null;
    }

    match /proveedores/{id} {
      allow read, write: if request.auth != null;
    }

    match /presupuestos/{id} {
      allow read, write: if request.auth != null;
    }

    match /autorizaciones/{id} {
      allow read, write: if request.auth != null;
    }

    match /eventos_calendario/{id} {
      allow read, write: if request.auth != null;
    }

    match /notas_prioritarias/{id} {
      allow read, write: if request.auth != null;
    }

    match /notificaciones/{id} {
      allow read, write: if request.auth != null;
    }

    match /sugerencias_ia/{id} {
      allow read, write: if request.auth != null;
    }

    match /ocupaciones/{id} {
      allow read, write: if request.auth != null;
    }

    match /asignaciones_proveedores/{id} {
      allow read, write: if request.auth != null;
    }

    // ---------- SUBCOLECCIONES DE RECLAMOS ----------
    match /reclamos/{reclamoId}/seguimientos/{id} {
      allow read, write: if request.auth != null;
    }

    match /reclamos/{reclamoId}/archivos/{id} {
      allow read, write: if request.auth != null;
    }

    match /reclamos/{reclamoId}/historial/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
